<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WritingIDE.Sdk</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>The WritingIDE extension SDK: write grammar rules, exporters and commands for WritingIDE.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WritingIDE.Core\WritingIDE.Core.csproj" />
  </ItemGroup>

</Project>