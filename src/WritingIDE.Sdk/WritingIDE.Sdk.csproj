<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WritingIDE.Sdk</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>The WritingIDE extension SDK: write grammar rules, exporters, commands and windows for WritingIDE.</Description>
    <!-- The SDK is MIT, unlike the rest of WritingIDE (GPL): see PLUGIN-EXCEPTION.md in the repository root. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WritingIDE.Core\WritingIDE.Core.csproj" />
  </ItemGroup>

</Project>