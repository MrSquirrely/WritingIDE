<!-- Light palette (Visual Studio "Blue/Light"). Dark.xaml defines the same keys; App swaps them at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:String x:Key="PaletteName">Light</sys:String>

  <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#1C97EA" />
  <SolidColorBrush x:Key="ChromeBrush" Color="#EEEEF2" />
  <SolidColorBrush x:Key="PanelBrush" Color="#F5F5F5" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FAFAFA" />
  <SolidColorBrush x:Key="TextBrush" Color="#1E1E1E" />
  <SolidColorBrush x:Key="LabelBrush" Color="#444444" />
  <SolidColorBrush x:Key="SubtleTextBrush" Color="#717171" />
  <SolidColorBrush x:Key="IconGreyBrush" Color="#5C5C5C" />
  <SolidColorBrush x:Key="DividerBrush" Color="#E3E3E8" />
  <SolidColorBrush x:Key="BadgeBrush" Color="#DDDDE6" />
  <SolidColorBrush x:Key="HoverBrush" Color="#C9DEF5" />
  <SolidColorBrush x:Key="HoverBorderBrush" Color="#3399FF" />
  <SolidColorBrush x:Key="CheckedBrush" Color="#DCE9F7" />
  <SolidColorBrush x:Key="TileHoverBrush" Color="#E5F1FB" />
  <SolidColorBrush x:Key="ListSelectionBrush" Color="#CCE8FF" />
  <SolidColorBrush x:Key="InfoPanelBrush" Color="#F5F8FD" />
  <SolidColorBrush x:Key="InfoBorderBrush" Color="#D6E4F5" />
  <SolidColorBrush x:Key="WarningPanelBrush" Color="#FFF8E5" />
  <SolidColorBrush x:Key="WarningPanelBorderBrush" Color="#F0D58C" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="#6B4B00" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#E51400" />
  <SolidColorBrush x:Key="WarningBrush" Color="#C88A00" />
  <SolidColorBrush x:Key="MessageBrush" Color="#1E7BC4" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#388A34" />
  <SolidColorBrush x:Key="BrandBrush" Color="#68217A" />

  <!-- Story element kinds and project items (icons, tree, semantic highlighting) -->
  <SolidColorBrush x:Key="CharacterBrush" Color="#267F99" />
  <SolidColorBrush x:Key="PlaceBrush" Color="#098658" />
  <SolidColorBrush x:Key="ItemBrush" Color="#795E26" />
  <SolidColorBrush x:Key="FactionBrush" Color="#0451A5" />
  <SolidColorBrush x:Key="EventBrush" Color="#AF00DB" />
  <SolidColorBrush x:Key="LoreBrush" Color="#C25E00" />
  <SolidColorBrush x:Key="BookBrush" Color="#8E5BB5" />
  <SolidColorBrush x:Key="FolderBrush" Color="#DCB67A" />

  <!-- Manuscript editor -->
  <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="EditorForegroundBrush" Color="#1E1E1E" />
  <SolidColorBrush x:Key="EditorLineNumberBrush" Color="#2B91AF" />
  <SolidColorBrush x:Key="EditorCurrentLineBrush" Color="#F5F8FD" />
  <SolidColorBrush x:Key="EditorCurrentLineBorderBrush" Color="#E6EBF5" />
  <SolidColorBrush x:Key="EditorSelectionBrush" Color="#ADD6FF" />
</ResourceDictionary>