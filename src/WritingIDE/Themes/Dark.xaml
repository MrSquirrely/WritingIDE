<!-- Dark palette (Visual Studio "Dark"). Same keys as Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:String x:Key="PaletteName">Dark</sys:String>

  <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#1C97EA" />
  <SolidColorBrush x:Key="ChromeBrush" Color="#2D2D30" />
  <SolidColorBrush x:Key="PanelBrush" Color="#252526" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1E1E" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#252526" />
  <SolidColorBrush x:Key="TextBrush" Color="#DCDCDC" />
  <SolidColorBrush x:Key="LabelBrush" Color="#C8C8C8" />
  <SolidColorBrush x:Key="SubtleTextBrush" Color="#9D9D9D" />
  <SolidColorBrush x:Key="IconGreyBrush" Color="#C5C5C5" />
  <SolidColorBrush x:Key="DividerBrush" Color="#3F3F46" />
  <SolidColorBrush x:Key="BadgeBrush" Color="#3F3F46" />
  <SolidColorBrush x:Key="HoverBrush" Color="#3E3E40" />
  <SolidColorBrush x:Key="HoverBorderBrush" Color="#3399FF" />
  <SolidColorBrush x:Key="CheckedBrush" Color="#094771" />
  <SolidColorBrush x:Key="TileHoverBrush" Color="#2A2D2E" />
  <SolidColorBrush x:Key="ListSelectionBrush" Color="#094771" />
  <SolidColorBrush x:Key="InfoPanelBrush" Color="#1B2836" />
  <SolidColorBrush x:Key="InfoBorderBrush" Color="#2B4A6B" />
  <SolidColorBrush x:Key="WarningPanelBrush" Color="#3A3220" />
  <SolidColorBrush x:Key="WarningPanelBorderBrush" Color="#6B5A2A" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="#E8C77A" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#F48771" />
  <SolidColorBrush x:Key="WarningBrush" Color="#CCA700" />
  <SolidColorBrush x:Key="MessageBrush" Color="#75BEFF" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#89D185" />
  <SolidColorBrush x:Key="BrandBrush" Color="#B180D7" />

  <!-- Story element kinds and project items (icons, tree, semantic highlighting) -->
  <SolidColorBrush x:Key="CharacterBrush" Color="#4EC9B0" />
  <SolidColorBrush x:Key="PlaceBrush" Color="#73C991" />
  <SolidColorBrush x:Key="ItemBrush" Color="#DCDCAA" />
  <SolidColorBrush x:Key="FactionBrush" Color="#569CD6" />
  <SolidColorBrush x:Key="EventBrush" Color="#C586C0" />
  <SolidColorBrush x:Key="LoreBrush" Color="#E2A162" />
  <SolidColorBrush x:Key="BookBrush" Color="#B180D7" />
  <SolidColorBrush x:Key="FolderBrush" Color="#DCB67A" />

  <!-- Manuscript editor -->
  <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1E1E1E" />
  <SolidColorBrush x:Key="EditorForegroundBrush" Color="#D4D4D4" />
  <SolidColorBrush x:Key="EditorLineNumberBrush" Color="#858585" />
  <SolidColorBrush x:Key="EditorCurrentLineBrush" Color="#262A30" />
  <SolidColorBrush x:Key="EditorCurrentLineBorderBrush" Color="#2F333A" />
  <SolidColorBrush x:Key="EditorSelectionBrush" Color="#264F78" />

  <!-- Comments, name lenses, focus mode -->
  <SolidColorBrush x:Key="CommentHighlightBrush" Color="#40C9A227" />
  <SolidColorBrush x:Key="CommentActiveHighlightBrush" Color="#88C9A227" />
  <SolidColorBrush x:Key="CommentCardBrush" Color="#2D2A20" />
  <SolidColorBrush x:Key="CommentCardBorderBrush" Color="#6B5A2A" />
  <SolidColorBrush x:Key="CommentMarginBrush" Color="#202020" />
  <SolidColorBrush x:Key="LensBrush" Color="#8F8F8F" />
  <SolidColorBrush x:Key="FocusBackgroundBrush" Color="#181818" />
</ResourceDictionary>