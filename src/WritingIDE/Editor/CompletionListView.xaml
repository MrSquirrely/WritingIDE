<UserControl x:Class="WritingIDE.Editor.CompletionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource TextBrush}">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" />
    </Border.Effect>
    <DockPanel Width="360">
      <!-- Header: which trigger opened the list -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="6,3">
        <DockPanel>
          <TextBlock x:Name="HintText" DockPanel.Dock="Right" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Text="Tab/Enter to insert" />
          <TextBlock x:Name="HeaderText" FontWeight="SemiBold" Foreground="{DynamicResource LabelBrush}" />
        </DockPanel>
      </Border>

      <!-- Quick info for the selected item -->
      <Border x:Name="DetailsPanel" DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="8,6">
        <StackPanel>
          <TextBlock x:Name="DetailsTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="DetailsText" Foreground="{DynamicResource LabelBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Margin="8,8" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

      <ListBox x:Name="Items" MaxHeight="230" BorderThickness="0" Focusable="False"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#E5F1FB" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListSelectionBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"
                         FontFamily="Segoe MDL2 Assets" FontSize="13" Width="20" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{DynamicResource SubtleTextBrush}" Margin="12,0,2,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>