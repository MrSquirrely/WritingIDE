<UserControl x:Class="WritingIDE.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Width="520" FontFamily="Segoe UI" FontSize="12">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="28,24">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" />
    </Border.Effect>
    <StackPanel>
      <DockPanel>
        <Image DockPanel.Dock="Left" Source="/Assets/WritingIDE.ico" Width="64" Height="64" Margin="0,0,18,0" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="WritingIDE" FontSize="26" FontWeight="Light" Foreground="{DynamicResource BrandBrush}" />
          <TextBlock x:Name="VersionText" Foreground="{DynamicResource SubtleTextBrush}" />
        </StackPanel>
      </DockPanel>

      <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                 Text="An IDE for novelists, modelled on Visual Studio: projects and series, story elements with IntelliSense, a grammar engine with an Error List, and AI-assisted import." />

      <TextBlock Style="{StaticResource FormLabel}" Text="Keyboard" Margin="0,16,0,6" />
      <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
          </Grid.RowDefinitions>
          <Grid.Resources>
            <Style TargetType="TextBlock">
              <Setter Property="Margin" Value="0,2" />
              <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
            </Style>
          </Grid.Resources>
          <TextBlock Grid.Row="0" FontFamily="Consolas" Margin="0,2,16,2" Text="person. place. item." />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="IntelliSense for story elements" />
          <TextBlock Grid.Row="1" FontFamily="Consolas" Text="Ctrl+Space" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="Complete any name at the caret" />
          <TextBlock Grid.Row="2" FontFamily="Consolas" Text="Ctrl+." />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="Quick actions and fixes" />
          <TextBlock Grid.Row="3" FontFamily="Consolas" Text="F12 / Shift+F12" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="Go To Definition / Find All References" />
          <TextBlock Grid.Row="4" FontFamily="Consolas" Text="F2  ·  F6" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="Rename everywhere  ·  Analyze manuscript" />
          <TextBlock Grid.Row="5" FontFamily="Consolas" Text="Ctrl+I" />
          <TextBlock Grid.Row="5" Grid.Column="1" Text="Import (with an AI prompt)" />
        </Grid>
      </Border>

      <TextBlock x:Name="CreditsText" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />

      <Button Style="{StaticResource PrimaryDialogButton}" Content="Close" HorizontalAlignment="Right" Margin="0,18,0,0" IsDefault="True" IsCancel="True"
              Command="hc:ControlCommands.Close" />
    </StackPanel>
  </Border>
</UserControl>