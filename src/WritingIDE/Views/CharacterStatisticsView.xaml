<UserControl x:Class="WritingIDE.Views.CharacterStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,16,24,24">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource TileButton}" Padding="10,5" Margin="0" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh statistics">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" Margin="0,0,6,0" />
            <TextBlock Text="Refresh" />
          </StackPanel>
        </Button>
        <StackPanel>
          <TextBlock Text="Character and POV Statistics" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>

      <!-- Characters -->
      <TextBlock Style="{StaticResource FormLabel}" Text="Characters" Margin="0,18,0,4" />
      <DataGrid Style="{StaticResource IdeDataGrid}" ItemsSource="{Binding Characters}" MaxHeight="360" AutomationProperties.Name="Character statistics"
                MouseDoubleClick="OnCharacterDoubleClick" ToolTip="Double-click a character to open it">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Character" Binding="{Binding Name}" Width="*" MinWidth="140" />
          <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*" MinWidth="90" />
          <DataGridTextColumn Header="Mentions" Binding="{Binding Stats.Mentions}" Width="70" />
          <DataGridTextColumn Header="Chapters" Binding="{Binding Stats.Chapters}" Width="66" />
          <DataGridTextColumn Header="POV" Binding="{Binding Stats.PovChapters}" Width="50" />
          <DataGridTextColumn Header="Lines" Binding="{Binding Stats.DialogueLines}" Width="50" />
          <DataGridTextColumn Header="Spoken" Binding="{Binding Stats.DialogueWords}" Width="60" />
          <DataGridTextColumn Header="First appears" Binding="{Binding FirstAppearance}" Width="1.3*" MinWidth="110" />
          <DataGridTextColumn Header="Last appears" Binding="{Binding LastAppearance}" Width="1.3*" MinWidth="110" />
        </DataGrid.Columns>
      </DataGrid>

      <!-- Presence heat map -->
      <TextBlock Style="{StaticResource FormLabel}" Text="Presence by chapter" Margin="0,20,0,2" />
      <TextBlock Text="Darker means more mentions. Click a square to open that chapter. Gaps show where a character drops out of the story." Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,6" />
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="180,0,0,2">
            <ItemsControl ItemsSource="{Binding ChapterNumbers}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Width="22" TextAlignment="Center" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Characters}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                  <TextBlock Text="{Binding Name}" Width="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Width="20" Height="18" Margin="1,0" CornerRadius="2" Background="{DynamicResource DividerBrush}" ToolTip="{Binding ToolTip}" Cursor="Hand"
                                MouseLeftButtonUp="OnCellClicked">
                          <Border CornerRadius="2" Background="{DynamicResource CharacterBrush}" Opacity="{Binding Intensity}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Point of view -->
      <Grid Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="420" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource FormLabel}" Text="Share of the manuscript by POV" Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding PovShares}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Width="{Binding BarWidth}" Height="14" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center">
                      <Run Text="{Binding Percent, Mode=OneWay}" /><Run Text="% · " /><Run Text="{Binding Chapters, Mode=OneWay}" /><Run Text=" ch." />
                    </TextBlock>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Style="{StaticResource FormLabel}" Text="POV by chapter" Margin="0,0,0,4" />
          <DataGrid Style="{StaticResource IdeDataGrid}" ItemsSource="{Binding PointsOfView}" MaxHeight="320" AutomationProperties.Name="Point of view by chapter"
                    MouseDoubleClick="OnPovDoubleClick" ToolTip="Double-click to open the chapter">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Chapter" Binding="{Binding ChapterTitle}" Width="*" />
              <DataGridTextColumn Header="Point of view" Binding="{Binding PointOfView}" Width="140" />
              <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90" />
              <DataGridTextColumn Header="Words" Binding="{Binding Words, StringFormat=N0}" Width="70" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>