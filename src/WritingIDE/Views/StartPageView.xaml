<UserControl x:Class="WritingIDE.Views.StartPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource SurfaceBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="48,36" MaxWidth="1000" HorizontalAlignment="Left">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,28">
        <TextBlock Text="WritingIDE" FontSize="34" FontWeight="Light" Foreground="{DynamicResource BrandBrush}" />
        <TextBlock Text="An integrated development environment for novels." FontSize="15" Foreground="{DynamicResource SubtleTextBrush}" />
      </StackPanel>

      <!-- Recent projects and the quick guide -->
      <StackPanel Grid.Row="1" Grid.Column="0">
        <TextBlock Text="Open recent" FontSize="18" Margin="0,0,0,10" />
        <TextBlock Text="No recent projects. Create one to get started." Foreground="{DynamicResource SubtleTextBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding RecentProjects.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding RecentProjects}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource TileButton}" Padding="10,6" Margin="0,0,0,4" CommandParameter="{Binding Path}"
                      Command="{Binding DataContext.Shell.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE82D;" FontSize="20" Foreground="{DynamicResource BrandBrush}" Margin="0,0,12,0" />
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Path}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="How it works" FontSize="18" Margin="0,28,0,10" />
        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="16,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <Grid.Resources>
              <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="TextWrapping" Value="Wrap" />
              </Style>
            </Grid.Resources>
            <TextBlock Grid.Row="0" FontFamily="Consolas" Foreground="{DynamicResource CharacterBrush}" Text="person." Margin="0,3,18,3" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="IntelliSense list of your characters (also character. / char.)" />
            <TextBlock Grid.Row="1" FontFamily="Consolas" Foreground="{DynamicResource PlaceBrush}" Text="place." />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Places (also location. / loc.)" />
            <TextBlock Grid.Row="2" FontFamily="Consolas" Foreground="{DynamicResource ItemBrush}" Text="item." />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Items and objects. Also faction. / group. and event." />
            <TextBlock Grid.Row="3" FontFamily="Consolas" Text="Ctrl+Space" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="Complete any story element name at the caret" />
            <TextBlock Grid.Row="4" FontFamily="Consolas" Text="Ctrl+." />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="Quick fixes for grammar and spelling squiggles" />
            <TextBlock Grid.Row="5" FontFamily="Consolas" Text="F12 / Shift+F12" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="Go to a character's definition / find every mention" />
            <TextBlock Grid.Row="6" FontFamily="Consolas" Text="F2" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="Rename a character everywhere in the manuscript" />
            <TextBlock Grid.Row="7" FontFamily="Consolas" Text="F6" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="Analyze the whole manuscript (the novel's 'build')" />
          </Grid>
        </Border>
      </StackPanel>

      <!-- Get started -->
      <StackPanel Grid.Row="1" Grid.Column="2">
        <TextBlock Text="Get started" FontSize="18" Margin="0,0,0,10" />
        <Button Style="{StaticResource TileButton}" Command="{Binding Shell.NewProjectCommand}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE8F4;" FontSize="26" Foreground="{DynamicResource BrandBrush}" Margin="0,0,14,0" />
            <StackPanel>
              <TextBlock Text="Create a new project" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Start from an empty novel, a short story or the sample." Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Style="{StaticResource TileButton}" Command="{Binding Shell.OpenProjectCommand}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE8DA;" FontSize="26" Foreground="#C09553" Margin="0,0,14,0" />
            <StackPanel>
              <TextBlock Text="Open a project" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Open an existing .novproj file." Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Style="{StaticResource TileButton}" Command="{Binding Shell.ImportCommand}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE8B5;" FontSize="26" Foreground="{DynamicResource MessageBrush}" Margin="0,0,14,0" />
            <StackPanel>
              <TextBlock Text="Import with AI" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Get a prompt for ChatGPT, Claude or any AI, then import its reply (or a .txt/.md draft) as chapters and story elements. Open or create a project first."
                         Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </Button>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>