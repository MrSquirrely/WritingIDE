<UserControl x:Class="WritingIDE.Views.PlotThreadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:inf="clr-namespace:WritingIDE.Infrastructure"
             Background="{DynamicResource SurfaceBrush}">
  <DockPanel Margin="24,16,24,16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Style="{StaticResource TileButton}" Padding="10,5" Margin="0,0,6,0" Command="{Binding AddCommand}" Content="+ New thread" AutomationProperties.Name="New plot thread" />
        <Button Style="{StaticResource TileButton}" Padding="10,5" Margin="0" Command="{Binding RefreshCommand}" Content="Refresh" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Plot Threads and Foreshadowing" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
        <TextBlock Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                   Text="Mark passages in a chapter with right-click > Mark for Plot Thread (setup, development or payoff). WritingIDE warns about setups never paid off and payoffs that come before their setup." />
      </StackPanel>
    </DockPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="200" MaxWidth="360" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="2*" MinWidth="240" />
      </Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" HorizontalContentAlignment="Stretch"
               AutomationProperties.Name="Plot threads">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2,5">
              <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Thread.Name}" />
              <TextBlock FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"><Run Text="{Binding Thread.Status, Mode=OneWay}" /><Run Text=" &#xB7; " /><Run Text="{Binding Counts, Mode=OneWay}" /></TextBlock>
              <TextBlock Text="{Binding Problems}" FontSize="11" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap"
                         Visibility="{Binding HasProblems, Converter={x:Static inf:BoolToVisibilityConverter.Normal}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}">
        <StackPanel>
          <TextBlock Style="{StaticResource FormLabel}" Text="Thread" />
          <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Thread.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Thread name" />
          <TextBlock Style="{StaticResource FormLabel}" Text="What it promises the reader" />
          <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Thread.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                   VerticalContentAlignment="Top" hc:InfoElement.Placeholder="e.g. The compass always points to where Tobias died." AutomationProperties.Name="Thread description" />
          <TextBlock Style="{StaticResource FormLabel}" Text="Status" />
          <ComboBox ItemsSource="{Binding DataContext.Statuses, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Thread.Status}" Width="160" HorizontalAlignment="Left" />
          <TextBlock Style="{StaticResource FormLabel}" Text="Marked passages, in reading order (double-click to go there)" Margin="0,16,0,4" />
          <DataGrid Style="{StaticResource IdeDataGrid}" ItemsSource="{Binding Markers}" MaxHeight="360" MouseDoubleClick="OnMarkerDoubleClick" AutomationProperties.Name="Marked passages">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Role" Binding="{Binding Marker.ThreadRole}" Width="90" />
              <DataGridTextColumn Header="Chapter" Binding="{Binding Chapter.Title}" Width="170" />
              <DataGridTextColumn Header="Passage" Binding="{Binding Excerpt}" Width="*" />
              <DataGridTextColumn Header="Note" Binding="{Binding Marker.Text}" Width="160" />
            </DataGrid.Columns>
          </DataGrid>
          <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="Delete this thread..."
                  Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>