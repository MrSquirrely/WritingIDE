<hc:Window x:Class="WritingIDE.Views.MainWindow" Icon="/Assets/WritingIDE.ico"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:vm="clr-namespace:WritingIDE.ViewModels"
           xmlns:inf="clr-namespace:WritingIDE.Infrastructure"
           Background="{DynamicResource ChromeBrush}" NonClientAreaBackground="{DynamicResource ChromeBrush}"
           FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True"
           ShowTitle="False" ShowIcon="False" Title="{Binding WindowTitle}" Width="1440" Height="900" WindowStartupLocation="CenterScreen">

  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding NewProjectCommand}" />
    <KeyBinding Key="O" Modifiers="Ctrl+Shift" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveAllCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAllCommand}" />
    <KeyBinding Key="A" Modifiers="Ctrl+Shift" Command="{Binding AddNewItemCommand}" />
    <KeyBinding Key="F6" Command="{Binding AnalyzeAllCommand}" />
    <KeyBinding Key="F9" Command="{Binding ToggleSprintCommand}" />
    <KeyBinding Key="B" Modifiers="Ctrl+Shift" Command="{Binding AnalyzeAllCommand}" />
    <KeyBinding Key="F4" Modifiers="Ctrl" Command="{Binding CloseDocumentCommand}" />
    <KeyBinding Key="I" Modifiers="Ctrl+Shift" Command="{Binding ImportCommand}" />
    <KeyBinding Key="F" Modifiers="Ctrl+Shift" Command="{Binding FindInFilesCommand}" />
    <KeyBinding Key="H" Modifiers="Ctrl+Shift" Command="{Binding ReplaceInFilesCommand}" />
    <KeyBinding Key="F11" Command="{Binding ToggleDistractionFreeCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl+Alt" Command="{Binding TakeSnapshotCommand}" />
    <KeyBinding Key="E" Modifiers="Ctrl+Shift" Command="{Binding ExportCommand}" />
  </Window.InputBindings>

  <Window.Resources>
    <!-- Solution Explorer node templates -->
    <HierarchicalDataTemplate DataType="{x:Type vm:ProjectNode}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Margin="0,1">
        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Margin="0,0,6,0" />
        <TextBlock FontWeight="SemiBold"><Run Text="{Binding KindLabel, Mode=OneWay}" /><Run Text=" '" /><Run Text="{Binding Project.Name, Mode=OneWay}" /><Run Text="'" /></TextBlock>
      </StackPanel>
    </HierarchicalDataTemplate>
    <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Margin="0,1">
        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Margin="0,0,6,0" />
        <TextBlock Text="{Binding Name}" />
        <TextBlock Text="{Binding Children.Count, StringFormat=' ({0})'}" Foreground="{DynamicResource SubtleTextBrush}" />
      </StackPanel>
    </HierarchicalDataTemplate>
    <HierarchicalDataTemplate DataType="{x:Type vm:BookNode}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Book.Synopsis}">
        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Margin="0,0,6,0" />
        <TextBlock Text="{Binding Book.Title}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Children.Count, StringFormat=' ({0})'}" Foreground="{DynamicResource SubtleTextBrush}" />
      </StackPanel>
    </HierarchicalDataTemplate>
    <DataTemplate DataType="{x:Type vm:StoryBibleNode}">
      <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="Premise, tone, themes, world rules and plot plan">
        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Margin="0,0,6,0" />
        <TextBlock Text="{Binding Title}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ChapterNode}">
      <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Chapter.Synopsis}">
        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Margin="0,0,6,0" />
        <TextBlock Text="{Binding Chapter.Title}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EntityNode}">
      <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding ToolTip}">
        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Margin="0,0,6,0" />
        <TextBlock Text="{Binding Entity.Name}" />
      </StackPanel>
    </DataTemplate>

    <!-- Right-hand "Chapter Info" panel for a chapter -->
    <DataTemplate x:Key="ChapterInfoTemplate" DataType="{x:Type vm:ChapterDocumentViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,4,10,10">
          <TextBlock Style="{StaticResource FormLabel}" Text="Title" />
          <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Chapter.Title, UpdateSourceTrigger=PropertyChanged}" />
          <StackPanel Visibility="{Binding IsInSeries, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource FormLabel}" Text="Book" />
            <ComboBox ItemsSource="{Binding Books}" SelectedItem="{Binding Book}" DisplayMemberPath="Title" />
          </StackPanel>
          <TextBlock Style="{StaticResource FormLabel}" Text="Status" />
          <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Chapter.Status}" />
          <TextBlock Style="{StaticResource FormLabel}" Text="Point of view" />
          <ComboBox IsEditable="True" ItemsSource="{Binding PointOfViewChoices}" Text="{Binding Chapter.PointOfView, UpdateSourceTrigger=LostFocus}"
                    hc:InfoElement.Placeholder="Detect automatically" AutomationProperties.Name="Point of view" />
          <TextBlock Style="{StaticResource FormLabel}" Text="Story date" />
          <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Chapter.StoryDate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Story date"
                   hc:InfoElement.Placeholder="e.g. Day 3, or 12 May 1204" ToolTip="When this chapter happens in the story. Used by the Timeline." />
          <TextBlock Style="{StaticResource FormLabel}" Text="Synopsis" />
          <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Chapter.Synopsis, UpdateSourceTrigger=PropertyChanged}"
                   TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" VerticalScrollBarVisibility="Auto" />

          <DockPanel Margin="0,16,0,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding AddCommentCommand}" Content="+ Add (Ctrl+Alt+M)" />
            <TextBlock Style="{StaticResource FormLabel}" Margin="0">
              <Run Text="Comments" /> <Run Text="{Binding OpenCommentCount, Mode=OneWay, StringFormat='({0} open)'}" Foreground="{DynamicResource SubtleTextBrush}" />
            </TextBlock>
          </DockPanel>

          <DockPanel Margin="0,12,0,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding TakeSnapshotCommand}" Content="+ Take snapshot" ToolTip="Save this version of the chapter (Ctrl+Alt+S)" />
            <TextBlock Style="{StaticResource FormLabel}" Margin="0" Text="Snapshots" />
          </DockPanel>
          <TextBlock Text="Save a version before a big revision; compare or restore it later." Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Snapshots.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Snapshots}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,3">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Padding="3" ToolTip="Compare with the current text" AutomationProperties.Name="Compare snapshot" CommandParameter="{Binding}"
                            Command="{Binding DataContext.CompareSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xE8CB;" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Padding="3" ToolTip="Revision mode: show the changes since this snapshot inline, to accept or reject" AutomationProperties.Name="Track changes since snapshot" CommandParameter="{Binding}"
                            Command="{Binding DataContext.TrackSinceSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Padding="3" ToolTip="Restore this version" AutomationProperties.Name="Restore snapshot" CommandParameter="{Binding}"
                            Command="{Binding DataContext.RestoreSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Padding="3" ToolTip="Delete snapshot" AutomationProperties.Name="Delete snapshot" CommandParameter="{Binding}"
                            Command="{Binding DataContext.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="11" Foreground="{DynamicResource ErrorBrush}" />
                    </Button>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource SubtleTextBrush}">
                      <Run Text="{Binding CreatedUtc, Mode=OneWay, Converter={x:Static inf:LocalTimeConverter.Instance}}" /><Run Text=" · " /><Run Text="{Binding Words, Mode=OneWay, StringFormat=N0}" /><Run Text=" words" />
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Revision mode (track changes) -->
          <TextBlock Style="{StaticResource FormLabel}" Text="Revision mode" Margin="0,16,0,4" />
          <TextBlock Text="Shows what you change from now on (or since a snapshot) inline: insertions in green, deletions struck through. Right-click a change to accept or reject it."
                     TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" Visibility="{Binding IsTrackingRevisions, Converter={x:Static inf:BoolToVisibilityConverter.Inverted}}" />
          <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Content="Start tracking changes" Command="{Binding StartRevisionsCommand}" Margin="0,4,0,0"
                  Visibility="{Binding IsTrackingRevisions, Converter={x:Static inf:BoolToVisibilityConverter.Inverted}}" AutomationProperties.Name="Start tracking changes" />
          <StackPanel Visibility="{Binding IsTrackingRevisions, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding RevisionSummary}" Foreground="{DynamicResource LabelBrush}" />
            <WrapPanel Margin="0,4,0,0">
              <Button Style="{StaticResource LinkButton}" Content="Next" Command="{Binding NextChangeCommand}" Margin="0,0,12,0" />
              <Button Style="{StaticResource LinkButton}" Content="Accept all" Command="{Binding AcceptAllCommand}" Margin="0,0,12,0" AutomationProperties.Name="Accept all changes" />
              <Button Style="{StaticResource LinkButton}" Content="Reject all" Command="{Binding RejectAllCommand}" Margin="0,0,12,0" AutomationProperties.Name="Reject all changes" />
              <Button Style="{StaticResource LinkButton}" Content="Stop" Command="{Binding StopRevisionsCommand}" AutomationProperties.Name="Stop tracking changes" />
            </WrapPanel>
          </StackPanel>

          <TextBlock Style="{StaticResource FormLabel}" Text="Statistics" Margin="0,16,0,4" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Words" Foreground="{DynamicResource SubtleTextBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Statistics.Words, StringFormat=N0}" />
            <TextBlock Grid.Row="1" Text="Sentences" Foreground="{DynamicResource SubtleTextBrush}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Statistics.Sentences, StringFormat=N0}" />
            <TextBlock Grid.Row="2" Text="Paragraphs" Foreground="{DynamicResource SubtleTextBrush}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Statistics.Paragraphs, StringFormat=N0}" />
            <TextBlock Grid.Row="3" Text="Avg. sentence length" Foreground="{DynamicResource SubtleTextBrush}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Statistics.AverageSentenceLength, StringFormat='{}{0} words'}" />
            <TextBlock Grid.Row="4" Text="Readability (Flesch)" Foreground="{DynamicResource SubtleTextBrush}" />
            <TextBlock Grid.Row="4" Grid.Column="1">
              <Run Text="{Binding Statistics.FleschReadingEase, Mode=OneWay}" /> <Run Text="{Binding Statistics.ReadabilityLabel, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource SubtleTextBrush}" />
            </TextBlock>
            <TextBlock Grid.Row="5" Text="Dialogue" Foreground="{DynamicResource SubtleTextBrush}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Statistics.DialoguePercent, StringFormat='{}{0}%'}" />
            <TextBlock Grid.Row="6" Text="Reading time" Foreground="{DynamicResource SubtleTextBrush}" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Statistics.ReadingTimeText}" />
          </Grid>

          <TextBlock Style="{StaticResource FormLabel}" Text="Story elements in this chapter" Margin="0,16,0,4" />
          <TextBlock Text="None mentioned yet." Foreground="{DynamicResource SubtleTextBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Mentions.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Mentions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource LinkButton}" Padding="0,2" Click="OnMentionClicked" Tag="{Binding Entity}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat='×{0}'}" Foreground="{DynamicResource SubtleTextBrush}" Margin="8,0,0,0" />
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" />
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
  </Window.Resources>

  <!-- ================= Title bar: menu and project badge (like Visual Studio 2022) ================= -->
  <hc:Window.NonClientAreaContent>
    <DockPanel LastChildFill="True">
      <Border DockPanel.Dock="Right" Background="{DynamicResource BadgeBrush}" CornerRadius="3" Padding="10,2" Margin="0,0,12,0" VerticalAlignment="Center"
              Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding ProjectTitle}" FontWeight="SemiBold" Foreground="{DynamicResource LabelBrush}" />
      </Border>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="/Assets/WritingIDE.ico" Width="18" Height="18" Margin="10,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
    <Menu Background="Transparent" VerticalAlignment="Center">
      <MenuItem Header="_File">
        <MenuItem Header="_New Project..." Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+Shift+N" />
        <MenuItem Header="_Open Project..." Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+Shift+O" />
        <MenuItem Header="_Close Project" Command="{Binding CloseProjectCommand}" />
        <Separator />
        <MenuItem Header="_Save All" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+S" />
        <Separator />
        <MenuItem Header="_Import..." Command="{Binding ImportCommand}" InputGestureText="Ctrl+Shift+I" />
        <MenuItem Header="_Export..." Command="{Binding ExportCommand}" InputGestureText="Ctrl+Shift+E" />
        <Separator />
        <MenuItem Header="Start _Page" Command="{Binding ShowStartPageCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGestureText="Alt+F4" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Command="ApplicationCommands.Undo" />
        <MenuItem Command="ApplicationCommands.Redo" />
        <Separator />
        <MenuItem Command="ApplicationCommands.Cut" />
        <MenuItem Command="ApplicationCommands.Copy" />
        <MenuItem Command="ApplicationCommands.Paste" />
        <Separator />
        <MenuItem Header="F_ormat">
          <MenuItem Header="_Bold" Command="{Binding BoldCommand}" InputGestureText="Ctrl+B" />
          <MenuItem Header="_Italic" Command="{Binding ItalicCommand}" InputGestureText="Ctrl+I" />
          <MenuItem Header="_Clear Formatting" Command="{Binding ClearFormattingCommand}" />
          <Separator />
          <MenuItem Header="_Fonts..." Command="{Binding FontsCommand}" />
        </MenuItem>
        <Separator />
        <MenuItem Command="ApplicationCommands.Find" InputGestureText="Ctrl+F" />
        <MenuItem Header="Find in _Files..." Command="{Binding FindInFilesCommand}" InputGestureText="Ctrl+Shift+F" />
        <MenuItem Header="Replace in File_s..." Command="{Binding ReplaceInFilesCommand}" InputGestureText="Ctrl+Shift+H" />
        <Separator />
        <MenuItem Header="Add _Comment" Command="{Binding AddCommentCommand}" InputGestureText="Ctrl+Alt+M" />
        <MenuItem Header="_List All Comments" Command="{Binding ListCommentsCommand}" />
        <MenuItem Header="Take Chapter Snaps_hot..." Command="{Binding TakeSnapshotCommand}" InputGestureText="Ctrl+Alt+S" />
        <MenuItem Header="Insert Scene _Break" Command="{Binding InsertSceneBreakCommand}" InputGestureText="Ctrl+Shift+Enter" />
        <MenuItem Header="_Bookmarks">
          <MenuItem Header="_Toggle Bookmark" Command="{Binding ToggleBookmarkCommand}" InputGestureText="Ctrl+K, Ctrl+K" />
          <MenuItem Header="_Next Bookmark" Command="{Binding NextBookmarkCommand}" InputGestureText="Ctrl+K, Ctrl+N" />
          <MenuItem Header="_Previous Bookmark" Command="{Binding PreviousBookmarkCommand}" InputGestureText="Ctrl+K, Ctrl+P" />
          <MenuItem Header="_Clear Bookmarks in Chapter" Command="{Binding ClearBookmarksCommand}" InputGestureText="Ctrl+K, Ctrl+L" />
        </MenuItem>
        <Separator />
        <MenuItem Command="ApplicationCommands.SelectAll" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Start Page" Command="{Binding ShowStartPageCommand}" />
        <MenuItem Header="_Error List" Click="OnShowErrorList" />
        <MenuItem Header="_Output" Click="OnShowOutput" />
        <MenuItem Header="_Find Results" Click="OnShowFindResults" />
        <Separator />
        <MenuItem Header="_Highlight Story Elements" IsCheckable="True" IsChecked="{Binding HighlightStoryElements}" />
        <MenuItem Header="_Name Lenses" IsCheckable="True" IsChecked="{Binding ShowNameLenses}" ToolTip="Reference counts above the first mention of each name, like CodeLens" />
        <MenuItem Header="_Comments" IsCheckable="True" IsChecked="{Binding ShowCommentMargin}" />
        <Separator />
        <MenuItem Header="_Distraction-Free Writing" Command="{Binding ToggleDistractionFreeCommand}" InputGestureText="F11" />
        <Separator />
        <MenuItem Header="Book_marks" Click="OnShowBookmarks" />
        <MenuItem Header="Tas_k List" Click="OnShowTaskList" />
        <MenuItem Header="O_utline" Click="OnShowOutline" />
        <Separator />
        <MenuItem Header="_Theme">
          <MenuItem Header="Use _Windows Setting" Command="{Binding SetThemeCommand}" CommandParameter="System" IsChecked="{Binding IsSystemTheme, Mode=OneWay}" />
          <MenuItem Header="_Light" Command="{Binding SetThemeCommand}" CommandParameter="Light" IsChecked="{Binding IsLightTheme, Mode=OneWay}" />
          <MenuItem Header="_Dark" Command="{Binding SetThemeCommand}" CommandParameter="Dark" IsChecked="{Binding IsDarkTheme, Mode=OneWay}" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Project">
        <MenuItem Header="Add New _Item..." Command="{Binding AddNewItemCommand}" InputGestureText="Ctrl+Shift+A" />
        <Separator />
        <MenuItem Header="Add _Book..." Command="{Binding AddBookCommand}" />
        <MenuItem Header="Add _Chapter..." Command="{Binding AddChapterCommand}" />
        <MenuItem Header="Add C_haracter..." Command="{Binding AddEntityCommand}" CommandParameter="Character" />
        <MenuItem Header="Add _Place..." Command="{Binding AddEntityCommand}" CommandParameter="Place" />
        <MenuItem Header="Add I_tem..." Command="{Binding AddEntityCommand}" CommandParameter="Item" />
        <MenuItem Header="Add _Faction..." Command="{Binding AddEntityCommand}" CommandParameter="Faction" />
        <MenuItem Header="Add _Event..." Command="{Binding AddEntityCommand}" CommandParameter="Event" />
        <Separator />
        <MenuItem Header="Story _Bible" Command="{Binding OpenStoryBibleCommand}" />
        <MenuItem Header="Con_vert to Series..." Command="{Binding ConvertToSeriesCommand}" />
        <Separator />
        <MenuItem Header="_Split Chapter at Caret..." Command="{Binding SplitChapterCommand}" />
        <MenuItem Header="_Merge with Next Chapter" Command="{Binding MergeWithNextCommand}" />
        <MenuItem Header="New Plot _Thread..." Command="{Binding NewPlotThreadCommand}" />
        <Separator />
        <MenuItem Header="P_roperties..." Command="{Binding OptionsCommand}" />
      </MenuItem>
      <MenuItem Header="_Analyze">
        <MenuItem Header="_Analyze Manuscript" Command="{Binding AnalyzeAllCommand}" InputGestureText="F6" />
        <Separator />
        <MenuItem Header="_Character and POV Statistics" Command="{Binding OpenCharacterStatisticsCommand}" />
        <MenuItem Header="_Timeline" Command="{Binding OpenTimelineCommand}" />
        <MenuItem Header="_Relationship Map" Command="{Binding OpenRelationshipMapCommand}" />
        <MenuItem Header="_Plot Threads" Command="{Binding OpenPlotThreadsCommand}" />
        <MenuItem Header="T_hread Chart" Command="{Binding OpenThreadChartCommand}" />
        <Separator />
        <MenuItem Header="Cork_board" Command="{Binding OpenCorkboardCommand}" />
        <MenuItem Header="_Beat Sheet" Command="{Binding OpenBeatSheetCommand}" />
        <Separator />
        <MenuItem Header="_Writing Progress" Command="{Binding OpenWritingProgressCommand}" />
        <MenuItem Header="Start or Stop Writing _Sprint" Command="{Binding ToggleSprintCommand}" InputGestureText="F9" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Auto-complete Names While Typing" IsCheckable="True" IsChecked="{Binding AutoCompleteNames}" />
        <Separator />
        <MenuItem Header="{Binding AutosaveLabel}" HeaderStringFormat="Auto_save to Disk ({0})">
          <MenuItem Header="Off (crash recovery only)" Command="{Binding SetAutosaveCommand}" CommandParameter="0" />
          <MenuItem Header="Every minute" Command="{Binding SetAutosaveCommand}" CommandParameter="1" />
          <MenuItem Header="Every 2 minutes" Command="{Binding SetAutosaveCommand}" CommandParameter="2" />
          <MenuItem Header="Every 5 minutes" Command="{Binding SetAutosaveCommand}" CommandParameter="5" />
          <MenuItem Header="Every 10 minutes" Command="{Binding SetAutosaveCommand}" CommandParameter="10" />
        </MenuItem>
        <MenuItem Header="_Fonts..." Command="{Binding FontsCommand}" />
        <MenuItem Header="_Extensions and API..." Command="{Binding PluginsCommand}" />
        <MenuItem Header="_Options..." Command="{Binding OptionsCommand}" />
      </MenuItem>
      <MenuItem Header="A_I">
        <MenuItem Header="_Ask About Your Book" Command="{Binding Ai.ChatCommand}" />
        <Separator />
        <MenuItem Header="_Summarize Chapter" Command="{Binding Ai.SummarizeCommand}" ToolTip="Writes the chapter's synopsis" />
        <MenuItem Header="_Beta Read Chapter" Command="{Binding Ai.BetaReadCommand}" ToolTip="Notes on the chapter appear as margin comments" />
        <MenuItem Header="Check _Continuity with AI" Command="{Binding Ai.ContinuityCommand}" ToolTip="Contradictions with the story bible appear as margin comments" />
        <MenuItem Header="_Rewrite Selection" IsEnabled="False" ToolTip="Select text in a chapter and right-click > AI" />
        <Separator />
        <MenuItem Header="AI _Settings..." Command="{Binding Ai.SettingsCommand}" />
      </MenuItem>
      <MenuItem x:Name="ExtensionsMenu" Header="E_xtensions" SubmenuOpened="OnExtensionsMenuOpened">
        <MenuItem Header="(no extension commands)" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_Window">
        <MenuItem Header="_Split: Open in Second Pane" Command="{Binding OpenInSplitPaneCommand}" ToolTip="Shows the current document in a second pane beside this one" />
        <MenuItem Header="_Close Second Pane" Command="{Binding CloseSplitPaneCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Check for _Updates..." Command="{Binding Updates.CheckCommand}" />
        <MenuItem Header="_Restart to Update" Command="{Binding Updates.RestartToUpdateCommand}"
                  Visibility="{Binding Updates.IsUpdateReady, Converter={StaticResource BoolToVisibility}}" />
        <Separator />
        <MenuItem Header="_About WritingIDE" Command="{Binding AboutCommand}" />
      </MenuItem>
    </Menu>
      </StackPanel>
    </DockPanel>
  </hc:Window.NonClientAreaContent>

  <DockPanel>

    <!-- ================= Tool bar ================= -->
    <Border x:Name="ToolBarHost" DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,1">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource ToolButton}" Command="{Binding NewProjectCommand}" ToolTip="New Project (Ctrl+Shift+N)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" Foreground="{DynamicResource BrandBrush}" />
        </Button>
        <Button Style="{StaticResource ToolButton}" Command="{Binding OpenProjectCommand}" ToolTip="Open Project (Ctrl+Shift+O)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8DA;" Foreground="#C09553" />
        </Button>
        <Button Style="{StaticResource ToolButton}" Command="{Binding SaveAllCommand}" ToolTip="Save All (Ctrl+S)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" Foreground="{DynamicResource MessageBrush}" />
        </Button>
        <Border Width="1" Margin="4,3" Background="{DynamicResource BorderBrush}" />
        <Button Style="{StaticResource ToolButton}" Command="ApplicationCommands.Undo" ToolTip="Undo (Ctrl+Z)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
        </Button>
        <Button Style="{StaticResource ToolButton}" Command="ApplicationCommands.Redo" ToolTip="Redo (Ctrl+Y)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;" />
        </Button>
        <Border Width="1" Margin="4,3" Background="{DynamicResource BorderBrush}" />
        <Button Style="{StaticResource ToolButton}" Command="{Binding BoldCommand}" ToolTip="Bold (Ctrl+B): wraps the selection or word in **" AutomationProperties.Name="Bold" Focusable="False">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8DD;" />
        </Button>
        <Button Style="{StaticResource ToolButton}" Command="{Binding ItalicCommand}" ToolTip="Italic (Ctrl+I): wraps the selection or word in *" AutomationProperties.Name="Italic" Focusable="False">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8DB;" />
        </Button>
        <ComboBox Width="170" Margin="4,1,2,1" ItemsSource="{Binding FontChoices}" SelectedItem="{Binding EditorFont}" AutomationProperties.Name="Editor font"
                  ToolTip="Editor font (Tools > Fonts to add your own)" Focusable="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <ComboBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ComboBox.ItemsPanel>
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="13" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Width="62" Margin="2,1,2,1" IsEditable="True" ItemsSource="{Binding FontSizes}" AutomationProperties.Name="Editor font size" ToolTip="Editor font size"
                  Text="{Binding EditorFontSize, UpdateSourceTrigger=LostFocus}" />
        <Border Width="1" Margin="4,3" Background="{DynamicResource BorderBrush}" />
        <Button Style="{StaticResource ToolButton}" Command="{Binding AddChapterCommand}" ToolTip="Add Chapter">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" Foreground="{DynamicResource IconGreyBrush}" />
            <TextBlock Text="Chapter" Margin="4,0,0,0" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Command="{Binding AddEntityCommand}" CommandParameter="Character" ToolTip="Add Character">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE77B;" Foreground="{DynamicResource CharacterBrush}" />
            <TextBlock Text="Character" Margin="4,0,0,0" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Command="{Binding AddEntityCommand}" CommandParameter="Place" ToolTip="Add Place">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE707;" Foreground="{DynamicResource PlaceBrush}" />
            <TextBlock Text="Place" Margin="4,0,0,0" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Command="{Binding AddNewItemCommand}" ToolTip="Add New Item (Ctrl+Shift+A)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Foreground="{DynamicResource SuccessBrush}" />
        </Button>
        <Button Style="{StaticResource ToolButton}" Command="{Binding ImportCommand}" ToolTip="Import chapters and story elements, e.g. from an AI (Ctrl+Shift+I)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B5;" Foreground="{DynamicResource MessageBrush}" />
            <TextBlock Text="Import" Margin="4,0,0,0" />
          </StackPanel>
        </Button>
        <Border Width="1" Margin="4,3" Background="{DynamicResource BorderBrush}" />
        <Button Style="{StaticResource ToolButton}" Command="{Binding AnalyzeAllCommand}" ToolTip="Analyze Manuscript (F6)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Foreground="{DynamicResource SuccessBrush}" />
            <TextBlock Text="Analyze" Margin="4,0,0,0" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- ================= Status bar ================= -->
    <Border x:Name="StatusBarHost" DockPanel.Dock="Bottom" Background="{DynamicResource AccentBrush}" Padding="8,3">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" TextElement.Foreground="White">
          <TextBlock Margin="16,0,0,0" FontWeight="SemiBold" Text="{Binding SprintText}" ToolTip="Writing sprint (F9 stops it)"
                     Visibility="{Binding IsSprinting, Converter={StaticResource BoolToVisibility}}" />
          <StackPanel Margin="16,0,0,0" Orientation="Horizontal" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnTodayClicked"
                      ToolTip="Words written today against your daily goal. Click for Writing Progress."
                      Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding TodayText}" />
            <ProgressBar Width="60" Height="5" Margin="6,1,0,0" VerticalAlignment="Center" Maximum="100" Value="{Binding TodayPercent, Mode=OneWay}"
                         AutomationProperties.Name="Today's words against the daily goal">
              <ProgressBar.Template>
                <ControlTemplate TargetType="ProgressBar">
                  <Grid>
                    <Border x:Name="PART_Track" Background="#55FFFFFF" CornerRadius="2" />
                    <Border x:Name="PART_Indicator" Background="White" CornerRadius="2" HorizontalAlignment="Left" />
                  </Grid>
                </ControlTemplate>
              </ProgressBar.Template>
            </ProgressBar>
          </StackPanel>
          <TextBlock Margin="16,0,0,0" Text="{Binding ActiveChapter.Statistics.Words, StringFormat='{}{0:N0} words in chapter', FallbackValue=''}" />
          <TextBlock Margin="16,0,0,0" Text="{Binding TotalWords, StringFormat='{}{0:N0} words total'}" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Margin="16,0,0,0" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
            <Run Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" /> <Run Text="{Binding ErrorCount, Mode=OneWay}" />
            <Run Text="  &#xE7BA;" FontFamily="Segoe MDL2 Assets" /> <Run Text="{Binding WarningCount, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Margin="16,0,0,0" Cursor="Hand" MouseLeftButtonUp="OnGitStatusClicked" ToolTip="Git Changes"
                     Visibility="{Binding Git.IsRepository, Converter={StaticResource BoolToVisibility}}">
            <Run Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" /> <Run Text="{Binding Git.StatusBarText, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Margin="24,0,0,0" MinWidth="110">
            <Run Text="Ln" /> <Run Text="{Binding CaretLine, Mode=OneWay}" /> <Run Text="  Col" /> <Run Text="{Binding CaretColumn, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" Foreground="White" />
      </DockPanel>
    </Border>

    <!-- ================= Main area ================= -->
    <Grid x:Name="MainGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" MinWidth="150" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="300" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="280" MinWidth="150" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="200" />
        <RowDefinition Height="4" />
        <RowDefinition Height="230" MinHeight="80" />
      </Grid.RowDefinitions>

      <!-- Solution Explorer -->
      <DockPanel x:Name="SolutionPanel" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Background="{DynamicResource PanelBrush}">
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolWindowHeader}">
          <TextBlock Style="{StaticResource ToolWindowTitle}" Text="Solution Explorer" />
        </Border>
        <hc:SearchBar DockPanel.Dock="Top" Margin="6,6,6,4" Style="{StaticResource SearchBarPlus}" IsRealTime="True"
                      hc:InfoElement.Placeholder="Search Solution Explorer" hc:InfoElement.ShowClearButton="True"
                      Text="{Binding SolutionFilter, UpdateSourceTrigger=PropertyChanged}"
                      Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
        <Grid>
          <TreeView x:Name="SolutionTree" ItemsSource="{Binding SolutionItems}" BorderThickness="0" Background="{DynamicResource SurfaceBrush}" Padding="2,4"
                    MouseDoubleClick="OnTreeDoubleClick" KeyDown="OnTreeKeyDown"
                    PreviewMouseRightButtonDown="OnTreePreviewRightButtonDown" ContextMenuOpening="OnTreeContextMenuOpening">
            <TreeView.ContextMenu>
              <ContextMenu />
            </TreeView.ContextMenu>
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeViewItemBaseStyle}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Visibility" Value="{Binding IsShown, Converter={StaticResource BoolToVisibility}}" />
                <Setter Property="MinHeight" Value="24" />
              </Style>
            </TreeView.ItemContainerStyle>
          </TreeView>
          <StackPanel VerticalAlignment="Center" Margin="20" Visibility="{Binding HasProject, Converter={x:Static inf:BoolToVisibilityConverter.Inverted}}"
                      x:Name="NoProjectHint">
            <TextBlock Text="No project is open." HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,6,0,0" Command="{Binding NewProjectCommand}" Content="Create a new novel" />
            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,4,0,0" Command="{Binding OpenProjectCommand}" Content="Open a project" />
          </StackPanel>
          <TextBlock VerticalAlignment="Top" Margin="12" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"
                     Visibility="{Binding NoFilterMatches, Converter={StaticResource BoolToVisibility}}">
            <Run Text="No items match '" /><Run Text="{Binding SolutionFilter, Mode=OneWay}" /><Run Text="'." />
          </TextBlock>
        </Grid>
      </DockPanel>

      <GridSplitter x:Name="LeftSplitter" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" HorizontalAlignment="Stretch" />

      <!-- Document well, and the optional second (split) pane beside it -->
      <Grid x:Name="EditorArea" Grid.Row="0" Grid.Column="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="200" />
          <ColumnDefinition x:Name="SplitSplitterColumn" Width="0" />
          <ColumnDefinition x:Name="SplitPaneColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />
        <DockPanel x:Name="SplitPane" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed">
          <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,2" Padding="8,3">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource TabCloseButton}" Command="{Binding CloseSplitPaneCommand}" ToolTip="Close the second pane" AutomationProperties.Name="Close second pane">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8" />
              </Button>
              <TextBlock VerticalAlignment="Center"><Run Text="&#xE89F;" FontFamily="Segoe MDL2 Assets" /> <Run Text="{Binding SecondaryTitle, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
            </DockPanel>
          </Border>
          <ContentControl Content="{Binding SecondaryView}" Focusable="False" />
        </DockPanel>
      <TabControl x:Name="DocumentWell" Grid.Column="0" Style="{StaticResource DocumentTabControl}"
                  ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument, Mode=TwoWay}">
        <TabControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}" MouseDown="OnTabHeaderMouseDown">
              <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="12" Margin="0,0,5,0" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              <Button Style="{StaticResource TabCloseButton}" ToolTip="Close (Ctrl+F4)"
                      Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8" />
              </Button>
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate>
            <ContentControl Content="{Binding View}" Focusable="False" />
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
      </Grid>

      <!-- HandyControls Growl notifications float over the document well -->
      <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,34,16,0" Panel.ZIndex="10">
        <StackPanel hc:Growl.GrowlParent="True" VerticalAlignment="Top" />
      </ScrollViewer>

      <!-- Distraction-free mode: a quiet word count, bottom right -->
      <TextBlock x:Name="FocusWordCount" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,28,16" Panel.ZIndex="5" Foreground="{DynamicResource SubtleTextBrush}" Opacity="0.7" IsHitTestVisible="False"
                 Visibility="{Binding IsDistractionFree, Converter={StaticResource BoolToVisibility}}">
        <Run Text="{Binding ActiveChapter.Statistics.Words, Mode=OneWay, StringFormat='{}{0:N0} words'}" /><Run Text="   ·   Esc or F11 to leave" />
      </TextBlock>

      <GridSplitter x:Name="BottomSplitter" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

      <!-- Bottom tool windows -->
      <TabControl x:Name="BottomPanel" Grid.Row="2" Grid.Column="2" Style="{StaticResource ToolTabControl}" SelectedIndex="{Binding SelectedBottomTab, Mode=TwoWay}" Background="{DynamicResource SurfaceBrush}">
        <TabItem>
          <TabItem.Header>
            <TextBlock>
              <Run Text="Error List" /> <Run Text="{Binding ErrorItems.Count, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource SubtleTextBrush}" />
            </TextBlock>
          </TabItem.Header>
          <DockPanel Background="{DynamicResource SurfaceBrush}">
            <Border DockPanel.Dock="Top" Style="{StaticResource ToolWindowHeader}" Background="{DynamicResource PanelBrush}">
              <StackPanel Orientation="Horizontal">
                <ComboBox Width="150" SelectedIndex="{Binding CurrentDocumentOnly, Converter={x:Static inf:BoolToIndexConverter.Instance}}" Margin="0,0,8,0">
                  <ComboBoxItem Content="Entire Manuscript" />
                  <ComboBoxItem Content="Current Chapter" />
                </ComboBox>
                <ToggleButton Style="{StaticResource ToolToggleButton}" IsChecked="{Binding ShowErrors}">
                  <TextBlock>
                    <Run Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ErrorBrush}" /> <Run Text="{Binding ErrorCount, Mode=OneWay}" /> <Run Text="Errors" />
                  </TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggleButton}" IsChecked="{Binding ShowWarnings}">
                  <TextBlock>
                    <Run Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" /> <Run Text="{Binding WarningCount, Mode=OneWay}" /> <Run Text="Warnings" />
                  </TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggleButton}" IsChecked="{Binding ShowMessages}">
                  <TextBlock>
                    <Run Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MessageBrush}" /> <Run Text="{Binding MessageCount, Mode=OneWay}" /> <Run Text="Messages" />
                  </TextBlock>
                </ToggleButton>
              </StackPanel>
            </Border>
            <DataGrid Style="{StaticResource IdeDataGrid}" ItemsSource="{Binding ErrorItems}" MouseDoubleClick="OnErrorDoubleClick" KeyDown="OnErrorKeyDown">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="34">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource Glyph}" Text="{Binding SeverityGlyph}" Foreground="{Binding SeverityBrush}" HorizontalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90" />
                <DataGridTextColumn Header="Chapter" Binding="{Binding Document}" Width="170" />
                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="50" />
                <DataGridTextColumn Header="Col" Binding="{Binding Column}" Width="45" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="Output">
          <DockPanel Background="{DynamicResource SurfaceBrush}">
            <Border DockPanel.Dock="Top" Style="{StaticResource ToolWindowHeader}" Background="{DynamicResource PanelBrush}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding ClearOutputCommand}" ToolTip="Clear All">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE894;" />
                </Button>
                <TextBlock Text="Show output from: Analysis" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}" />
              </DockPanel>
            </Border>
            <TextBox x:Name="OutputBox" Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="OnOutputChanged" Padding="4" />
          </DockPanel>
        </TabItem>
        <TabItem Header="Find Results">
          <DockPanel Background="{DynamicResource SurfaceBrush}">
            <Border DockPanel.Dock="Top" Style="{StaticResource ToolWindowHeader}" Background="{DynamicResource PanelBrush}">
              <TextBlock Text="{Binding ReferencesHeader}" Foreground="{DynamicResource LabelBrush}" />
            </Border>
            <DataGrid Style="{StaticResource IdeDataGrid}" ItemsSource="{Binding References}" MouseDoubleClick="OnReferenceDoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Chapter" Binding="{Binding Document}" Width="170" />
                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="50" />
                <DataGridTextColumn Header="Col" Binding="{Binding Column}" Width="45" />
                <DataGridTextColumn Header="Text" Binding="{Binding Preview}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <!-- ================= Git Changes ================= -->
        <TabItem DataContext="{Binding Git}">
          <TabItem.Header>
            <TextBlock>
              <Run Text="Git Changes" /> <Run Text="{Binding Changes.Count, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource SubtleTextBrush}" />
            </TextBlock>
          </TabItem.Header>
          <Grid Background="{DynamicResource SurfaceBrush}">
            <!-- Git missing / project not in a repository -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsNotRepository, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="This project is not in a Git repository." HorizontalAlignment="Center" Foreground="{DynamicResource LabelBrush}" />
              <TextBlock Text="Git keeps every version of your manuscript, so you can see what changed and go back." HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,4,0,10" />
              <Button Style="{StaticResource PrimaryDialogButton}" Content="Create Git Repository" AutomationProperties.Name="Create Git Repository" HorizontalAlignment="Center" Margin="0" Command="{Binding InitCommand}" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" Text="{Binding Message}"
                       Visibility="{Binding IsGitInstalled, Converter={x:Static inf:BoolToVisibilityConverter.Inverted}}" />

            <Grid Visibility="{Binding IsRepository, Converter={StaticResource BoolToVisibility}}" Margin="8,6,8,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding PullCommand}" AutomationProperties.Name="Pull" ToolTip="Pull (fast-forward only)">
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding PushCommand}" AutomationProperties.Name="Push" ToolTip="Push">
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xE898;" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding AddRemoteCommand}" AutomationProperties.Name="Add remote" ToolTip="Add remote (connect to GitHub or another host)">
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh Git status" ToolTip="Refresh">
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                    </Button>
                  </StackPanel>
                  <TextBlock VerticalAlignment="Center">
                    <Run Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MessageBrush}" />
                    <Run Text="{Binding Branch, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding Ahead, Mode=OneWay, StringFormat='  ↑{0}'}" Foreground="{DynamicResource SubtleTextBrush}" />
                    <Run Text="{Binding Behind, Mode=OneWay, StringFormat='↓{0}'}" Foreground="{DynamicResource SubtleTextBrush}" />
                  </TextBlock>
                </DockPanel>
                <TextBox DockPanel.Dock="Top" Style="{StaticResource FormTextBox}" Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Commit message" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="44" MaxHeight="80" VerticalContentAlignment="Top" hc:InfoElement.Placeholder="Commit message, e.g. &quot;Draft chapter 14&quot;" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,6,0,4">
                  <Button Style="{StaticResource PrimaryDialogButton}" Margin="0,0,8,0" Content="Commit All" AutomationProperties.Name="Commit All" Command="{Binding CommitCommand}" ToolTip="Saves, then commits every change" />
                  <Button Style="{StaticResource DialogButton}" Margin="0" Content="Commit All and Push" AutomationProperties.Name="Commit All and Push" Command="{Binding CommitAndPushCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Message}" />
              </DockPanel>

              <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{Binding ChangesHeader}" FontWeight="SemiBold" Foreground="{DynamicResource LabelBrush}" Margin="0,4,0,4" />
                <ListBox ItemsSource="{Binding Changes}" BorderThickness="0" HorizontalContentAlignment="Stretch" MouseDoubleClick="OnGitChangeDoubleClick"
                         ToolTip="Double-click to see what changed">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel ToolTip="{Binding Path}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLetter}" Foreground="{Binding StatusBrush}" FontWeight="Bold" Margin="8,0,4,0" ToolTip="{Binding StatusDescription}" />
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>

              <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="History" FontWeight="SemiBold" Foreground="{DynamicResource LabelBrush}" Margin="0,4,0,4" />
                <ListBox ItemsSource="{Binding History}" BorderThickness="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Commit history"
                         MouseDoubleClick="OnGitCommitDoubleClick" KeyDown="OnGitCommitKeyDown" ToolTip="Double-click a commit to see what it changed">
                  <ListBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="View Changes" Command="{Binding OpenCommitCommand}"
                                CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                      <MenuItem Header="Copy Commit ID" Command="{Binding CopyCommitIdCommand}"
                                CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                  </ListBox.ContextMenu>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel>
                        <DockPanel.Resources>
                          <!-- The dim colours are unreadable on the selection highlight; use the selected text colour there. -->
                          <Style x:Key="HistoryDetail" TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </DockPanel.Resources>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Margin="8,0,0,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HistoryDetail}">
                              <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Hash}" FontFamily="Consolas" Margin="0,0,8,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HistoryDetail}">
                              <Setter Property="Foreground" Value="{DynamicResource MessageBrush}" />
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Author}" />
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Grid>
          </Grid>
        </TabItem>
        <!-- ================= Bookmarks ================= -->
        <TabItem>
          <TabItem.Header>
            <TextBlock>
              <Run Text="Bookmarks" /> <Run Text="{Binding BookmarkItems.Count, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource SubtleTextBrush}" />
            </TextBlock>
          </TabItem.Header>
          <DockPanel Background="{DynamicResource SurfaceBrush}">
            <Border DockPanel.Dock="Top" Style="{StaticResource ToolWindowHeader}" Background="{DynamicResource PanelBrush}">
              <TextBlock Text="Ctrl+K, Ctrl+K toggles a bookmark on the current line (or click the gutter). Ctrl+K, Ctrl+N / Ctrl+P move between them. Double-click a row to go there." Foreground="{DynamicResource LabelBrush}" />
            </Border>
            <DataGrid Style="{StaticResource IdeDataGrid}" ItemsSource="{Binding BookmarkItems}" MouseDoubleClick="OnReferenceDoubleClick" AutomationProperties.Name="Bookmarks">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Chapter" Binding="{Binding Document}" Width="170" />
                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="50" />
                <DataGridTextColumn Header="Text" Binding="{Binding Preview}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <!-- ================= Task List ================= -->
        <TabItem>
          <TabItem.Header>
            <TextBlock>
              <Run Text="Task List" /> <Run Text="{Binding TaskItems.Count, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource SubtleTextBrush}" />
            </TextBlock>
          </TabItem.Header>
          <DockPanel Background="{DynamicResource SurfaceBrush}">
            <Border DockPanel.Dock="Top" Style="{StaticResource ToolWindowHeader}" Background="{DynamicResource PanelBrush}">
              <TextBlock Text="TODO, FIXME, XXX and TK (to come) left in the manuscript, e.g. &quot;TODO: check the date&quot;. Double-click a row to go there." Foreground="{DynamicResource LabelBrush}" />
            </Border>
            <DataGrid Style="{StaticResource IdeDataGrid}" ItemsSource="{Binding TaskItems}" MouseDoubleClick="OnReferenceDoubleClick" AutomationProperties.Name="Task list">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Task" Binding="{Binding Preview}" Width="*" />
                <DataGridTextColumn Header="Chapter" Binding="{Binding Document}" Width="170" />
                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="50" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
      </TabControl>

      <GridSplitter x:Name="RightSplitter" Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" HorizontalAlignment="Stretch" />

      <!-- Right-hand panel: chapter info or project overview -->
      <TabControl x:Name="PropertiesPanel" Grid.Row="0" Grid.RowSpan="3" Grid.Column="4" Style="{StaticResource ToolTabControl}" Background="{DynamicResource SurfaceBrush}">
      <TabItem Header="Properties">
      <DockPanel Background="{DynamicResource SurfaceBrush}">
        <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding Project.Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Project.Author, StringFormat='by {0}'}" Foreground="{DynamicResource SubtleTextBrush}" />
            <ProgressBar Style="{StaticResource ProgressBarFlat}" Value="{Binding ProgressPercent, Mode=OneWay}" Height="6" Margin="0,8,0,3" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Background="{DynamicResource DividerBrush}" />
            <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" />
            <TextBlock Text="{Binding ElementSummary}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <ContentControl Content="{Binding ActiveChapter}" ContentTemplate="{StaticResource ChapterInfoTemplate}" Focusable="False">
          <ContentControl.Style>
            <Style TargetType="ContentControl">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveChapter}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
        </ContentControl>
      </DockPanel>
      </TabItem>

      <!-- Document Outline: scenes, bookmarks, tasks, comments and plot-thread passages of the current chapter -->
      <TabItem x:Name="OutlineTab" Header="Outline">
        <DockPanel Background="{DynamicResource SurfaceBrush}" DataContext="{Binding ActiveChapter}">
          <TextBlock DockPanel.Dock="Top" Margin="10,8,10,4" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11"
                     Text="Scenes (separated by * * *), bookmarks, TODOs, comments and plot-thread passages. Click to go there." />
          <TextBlock DockPanel.Dock="Top" Margin="10,8" Text="Open a chapter to see its outline." Foreground="{DynamicResource SubtleTextBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ListBox ItemsSource="{Binding Outline}" BorderThickness="0" HorizontalContentAlignment="Stretch" SelectionChanged="OnOutlineSelected" AutomationProperties.Name="Outline"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,1">
                  <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding Glyph}" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource IconGreyBrush}" />
                  <StackPanel>
                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScene}" Value="True">
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"><Run Text="{Binding KindLabel, Mode=OneWay}" /><Run Text=" &#xB7; line " /><Run Text="{Binding Line, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Details, Mode=OneWay}" /></TextBlock>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</hc:Window>