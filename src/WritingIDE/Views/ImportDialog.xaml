<hc:Window x:Class="WritingIDE.Views.ImportDialog" Icon="/Assets/WritingIDE.ico"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="Import into project" Width="1100" Height="740" MinWidth="860" MinHeight="560"
           WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}" FontFamily="Segoe UI" FontSize="12"
           NonClientAreaBackground="{DynamicResource ChromeBrush}">
  <DockPanel>
    <!-- Footer -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="ImportButton" Style="{StaticResource PrimaryDialogButton}" Content="Import" IsDefault="True" IsEnabled="False" Click="OnImport" />
          <Button Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True" />
        </StackPanel>
        <WrapPanel>
          <TextBlock Text="If an item already exists:" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox x:Name="ConflictBox" Width="270" SelectedIndex="0" SelectionChanged="OnConflictModeChanged" HorizontalAlignment="Left">
            <ComboBoxItem Content="Update it (merge details, replace text)" />
            <ComboBoxItem Content="Skip it (keep what I have)" />
            <ComboBoxItem Content="Add the imported one as new" />
          </ComboBox>
          <StackPanel x:Name="TargetBookPanel" Orientation="Horizontal" Margin="16,0,0,0" Visibility="Collapsed">
            <TextBlock Text="Chapters without a book go into:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="TargetBookBox" Width="200" DisplayMemberPath="Title" SelectionChanged="OnConflictModeChanged" />
          </StackPanel>
          <CheckBox x:Name="ConvertCheck" Margin="16,4,0,4" VerticalAlignment="Center" Visibility="Collapsed" Checked="OnConvertChanged" Unchecked="OnConvertChanged" />
          <CheckBox x:Name="OutlineCheck" Margin="16,4,0,4" VerticalAlignment="Center" Visibility="Collapsed" IsChecked="True" Checked="OnConvertChanged" Unchecked="OnConvertChanged"
                    ToolTip="Planned chapters (Status: Outline) become chapter-plan notes in the Story/Series Bible instead of chapters in the manuscript" />
        </WrapPanel>
      </DockPanel>
    </Border>

    <TabControl x:Name="Tabs" Style="{StaticResource TabControlInLine}" Margin="16,12,16,8">
      <!-- ======================= Step 1: prompt ======================= -->
      <TabItem Header="1.  Ask an AI to format your material">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Let an AI do the formatting" FontSize="16" FontWeight="SemiBold" />
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource LabelBrush}" Margin="0,4,0,0"
                         Text="Copy the prompt into ChatGPT, Claude, Gemini or any chat AI. It answers in a format WritingIDE can import: chapters plus characters, places and other story elements." />

              <TextBlock Style="{StaticResource FormLabel}" Text="What should the AI do?" Margin="0,16,0,6" />
              <RadioButton x:Name="BibleRadio" GroupName="Mode" IsChecked="True" HorizontalAlignment="Left" Margin="0,0,0,2"
                           Content="Convert a story bible we made in the chat" Checked="OnOptionChanged" />
              <TextBlock Text="World, cast and lore become story elements; premise, themes and the chapter plan go into the bible notes." Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,8" />
              <RadioButton x:Name="ManuscriptRadio" GroupName="Mode" HorizontalAlignment="Left" Margin="0,0,0,2"
                           Content="Convert a manuscript the AI wrote in the chat" Checked="OnOptionChanged" />
              <TextBlock Text="Every chapter, word for word, plus the characters and places in it. Long books come in parts." Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,8" />
              <RadioButton x:Name="CombineRadio" GroupName="Mode" HorizontalAlignment="Left" Margin="0,0,0,2"
                           Content="Combine a whole series (several manuscripts and bibles)" Checked="OnOptionChanged" />
              <TextBlock Text="Merges every bible into one Series Bible and one entry per character, place and thing; each manuscript becomes a book. Imports as a series." Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,8" />
              <RadioButton x:Name="ConvertRadio" GroupName="Mode" HorizontalAlignment="Left" Margin="0,0,0,6"
                           Content="Convert my own draft or notes (pasted below)" Checked="OnOptionChanged" />
              <RadioButton x:Name="DevelopRadio" GroupName="Mode" HorizontalAlignment="Left"
                           Content="Develop a story idea into elements and chapters" Checked="OnOptionChanged" />

              <TextBlock Style="{StaticResource FormLabel}" Text="Include" Margin="0,16,0,6" />
              <WrapPanel x:Name="IncludePanel">
                <CheckBox x:Name="ChaptersCheck" Content="Chapters" IsChecked="True" Margin="0,0,14,6" Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                <CheckBox x:Name="NotesCheck" Content="Story notes" IsChecked="True" Margin="0,0,14,6" Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                          ToolTip="Premise, tone, themes and plot plan go into the Story Bible" />
              </WrapPanel>

              <DockPanel Margin="0,10,0,0" x:Name="ChapterCountPanel">
                <TextBlock Text="Chapters to write" VerticalAlignment="Center" Width="120" />
                <hc:NumericUpDown x:Name="ChapterCountBox" Minimum="1" Maximum="60" Value="3" Width="110" HorizontalAlignment="Left" />
              </DockPanel>

              <StackPanel x:Name="SourcesPanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FormLabel}" Text="Manuscripts and bibles" Margin="0,16,0,4" />
                <TextBlock Text="Add each book's manuscript and every bible (.txt, .md or .docx). They go into the prompt, labelled with their file names. Leave empty if they are already in your AI chat."
                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ListBox x:Name="SourcesList" Height="110" BorderBrush="{DynamicResource BorderBrush}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Source files"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel ToolTip="{Binding Path}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding WordsText}" Foreground="{DynamicResource SubtleTextBrush}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Source.Name}" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Margin="0,6,0,0">
                  <TextBlock x:Name="SourcesTotal" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource DialogButton}" Margin="0,0,8,0" Content="Add files..." AutomationProperties.Name="Add files" Click="OnAddSources" />
                    <Button Style="{StaticResource DialogButton}" Margin="0" Content="Remove" AutomationProperties.Name="Remove file" Click="OnRemoveSource" />
                  </StackPanel>
                </DockPanel>
              </StackPanel>

              <TextBlock x:Name="MaterialLabel" Style="{StaticResource FormLabel}" Text="Your material (optional)" Margin="0,16,0,4" />
              <TextBox x:Name="MaterialBox" Style="{StaticResource FormTextBox}" Height="150" TextWrapping="Wrap" AcceptsReturn="True"
                       VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="OnOptionChanged" />
              <TextBlock x:Name="ModeHint" TextWrapping="Wrap" Foreground="{DynamicResource LabelBrush}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
          </ScrollViewer>

          <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock x:Name="CopyStatus" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0" />
                <Button Style="{StaticResource DialogButton}" Content="Save as .txt..." Click="OnSavePrompt" />
                <Button x:Name="SendButton" Style="{StaticResource DialogButton}" Click="OnSendToAi" AutomationProperties.Name="Send to AI">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE724;" Margin="0,0,6,0" />
                    <TextBlock x:Name="SendLabel" Text="Send to AI" />
                  </StackPanel>
                </Button>
                <Button x:Name="StopButton" Style="{StaticResource DialogButton}" Content="Stop after this part" Visibility="Collapsed" Click="OnStopAi" />
                <Button Style="{StaticResource PrimaryDialogButton}" Click="OnCopyPrompt">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" Margin="0,0,6,0" />
                    <TextBlock Text="Copy prompt" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <TextBlock Text="Prompt" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="AiStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource LabelBrush}" Margin="0,0,0,6" Visibility="Collapsed" />
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource InfoPanelBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,8,0,0">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="Next: paste the reply" Click="OnNextStep" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}"
                           Text="When the AI has answered, copy its whole reply and paste it on the next tab. Long books can be done a few chapters at a time; importing again adds to the project." />
              </DockPanel>
            </Border>
            <TextBox x:Name="PromptBox" Style="{StaticResource FormTextBox}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="{DynamicResource SurfaceAltBrush}" />
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- ======================= Step 2: paste and preview ======================= -->
      <TabItem Header="2.  Paste the reply and preview">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="380" />
          </Grid.ColumnDefinitions>

          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
              <Button Style="{StaticResource PrimaryDialogButton}" Margin="0,0,8,0" Click="OnPasteClipboard">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" Margin="0,0,6,0" />
                  <TextBlock Text="Paste from clipboard" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource DialogButton}" Margin="0,0,8,0" Click="OnOpenFile">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" Margin="0,0,6,0" />
                  <TextBlock Text="Open file..." />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource DialogButton}" Margin="0" Content="Clear" Click="OnClear" />
            </StackPanel>
            <TextBox x:Name="InputBox" Style="{StaticResource FormTextBox}" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" TextChanged="OnInputChanged"
                     hc:InfoElement.Placeholder="Paste the AI's reply here. Plain text or Markdown files work too: chapters are split at headings such as 'Chapter 1' or '# Prologue'." />
          </DockPanel>

          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Preview" FontSize="16" FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" TextWrapping="Wrap" Foreground="{DynamicResource LabelBrush}" Margin="0,4,0,8" Text="Nothing to import yet." />
            <Border DockPanel.Dock="Bottom" x:Name="WarningsPanel" Background="{DynamicResource WarningPanelBrush}" BorderBrush="{DynamicResource WarningPanelBorderBrush}" BorderThickness="1" Padding="8,6" Margin="0,8,0,0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}">
                  <Run Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" /> <Run Text="Warnings" />
                </TextBlock>
                <ItemsControl x:Name="WarningsList" Margin="0,4,0,0" MaxHeight="120">
                  <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                      <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                      </ScrollViewer>
                    </ControlTemplate>
                  </ItemsControl.Template>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" Margin="0,1">
                        <Run Text="{Binding Line, Mode=OneWay, StringFormat='Line {0}: '}" Foreground="{DynamicResource WarningTextBrush}" /><Run Text="{Binding Message, Mode=OneWay}" />
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <ListBox x:Name="PreviewList" BorderBrush="{DynamicResource BorderBrush}" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="2,3">
                    <Border DockPanel.Dock="Right" Background="{Binding ActionBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Margin="8,0,0,0">
                      <TextBlock Text="{Binding Action}" Foreground="White" FontSize="11" />
                    </Border>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontSize="15" Margin="0,0,10,0" />
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</hc:Window>