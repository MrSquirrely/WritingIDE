<hc:Window x:Class="WritingIDE.Views.FindReplaceDialog" Icon="/Assets/WritingIDE.ico"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="Find and Replace" Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
           WindowStartupLocation="CenterOwner" Background="{DynamicResource ChromeBrush}" NonClientAreaBackground="{DynamicResource ChromeBrush}"
           FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource TextBrush}">
  <StackPanel Margin="16,12,16,14">
    <TextBlock Text="Find what" Style="{StaticResource FormLabel}" Margin="0,0,0,3" />
    <TextBox x:Name="FindBox" AutomationProperties.Name="Find what" Style="{StaticResource FormTextBox}" TextChanged="OnInputChanged" hc:InfoElement.Placeholder="Text or regular expression" />

    <TextBlock Text="Replace with" Style="{StaticResource FormLabel}" />
    <TextBox x:Name="ReplaceBox" AutomationProperties.Name="Replace with" Style="{StaticResource FormTextBox}" hc:InfoElement.Placeholder="Replacement (with regular expressions, $1 inserts group 1)" />

    <WrapPanel Margin="0,10,0,0">
      <CheckBox x:Name="MatchCaseCheck" Content="Match case" Margin="0,0,16,4" Checked="OnInputChanged" Unchecked="OnInputChanged" />
      <CheckBox x:Name="WholeWordCheck" Content="Match whole word" Margin="0,0,16,4" Checked="OnInputChanged" Unchecked="OnInputChanged" />
      <CheckBox x:Name="RegexCheck" Content="Use regular expressions" Margin="0,0,16,4" Checked="OnInputChanged" Unchecked="OnInputChanged" />
    </WrapPanel>

    <DockPanel Margin="0,8,0,0">
      <TextBlock Text="Look in" VerticalAlignment="Center" Width="60" />
      <ComboBox x:Name="ScopeBox" Width="220" HorizontalAlignment="Left" SelectedIndex="0">
        <ComboBoxItem Content="Entire project" />
        <ComboBoxItem x:Name="BookScopeItem" Content="Current book" />
        <ComboBoxItem Content="Current chapter" />
      </ComboBox>
    </DockPanel>

    <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" MinHeight="16" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="FindAllButton" Style="{StaticResource PrimaryDialogButton}" Content="Find All" AutomationProperties.Name="Find All" IsDefault="True" Click="OnFindAll" />
      <Button x:Name="ReplaceAllButton" Style="{StaticResource DialogButton}" Content="Replace All" AutomationProperties.Name="Replace All" Click="OnReplaceAll" />
      <Button Style="{StaticResource DialogButton}" Content="Close" IsCancel="True" Click="OnClose" />
    </StackPanel>
  </StackPanel>
</hc:Window>