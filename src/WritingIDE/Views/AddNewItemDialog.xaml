<hc:Window x:Class="WritingIDE.Views.AddNewItemDialog" Icon="/Assets/WritingIDE.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Add New Item" Width="720" Height="460" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="{DynamicResource ChromeBrush}" FontFamily="Segoe UI" FontSize="12">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBrush}" Padding="14,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource PrimaryDialogButton}" Content="_Add" IsDefault="True" Click="OnAdd" />
          <Button Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True" />
        </StackPanel>
        <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="NameBox" Style="{StaticResource FormTextBox}" Margin="0,0,10,0" />
      </DockPanel>
    </Border>
    <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="{DynamicResource ErrorBrush}" Margin="14,0,14,0" />
    <Grid Margin="14,14,14,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="230" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="ItemList" HorizontalContentAlignment="Stretch" BorderBrush="{DynamicResource BorderBrush}" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnAdd">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="4,5">
              <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" Foreground="{DynamicResource SubtleTextBrush}" Margin="20,0,6,0" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="18" Margin="0,0,12,0" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,1" Padding="12">
        <StackPanel>
          <TextBlock Text="Type:" Foreground="{DynamicResource SubtleTextBrush}" />
          <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,8" />
          <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" Foreground="{DynamicResource LabelBrush}" />
          <TextBlock x:Name="DetailTrigger" TextWrapping="Wrap" Foreground="{DynamicResource CharacterBrush}" FontFamily="Consolas" Margin="0,10,0,0" />
          <StackPanel x:Name="BookPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="In book:" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,4" />
            <ComboBox x:Name="BookBox" DisplayMemberPath="Title" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</hc:Window>