<hc:Window x:Class="WritingIDE.Views.NewProjectDialog" Icon="/Assets/WritingIDE.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Create a new project" Width="780" Height="540" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}" FontFamily="Segoe UI" FontSize="12">
  <DockPanel Margin="24,18,24,18">
    <TextBlock DockPanel.Dock="Top" Text="Create a new project" FontSize="24" FontWeight="Light" Margin="0,0,0,14" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource PrimaryDialogButton}" Content="_Create" IsDefault="True" Click="OnCreate" />
      <Button Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True" />
    </StackPanel>

    <!-- Configure -->
    <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Text="Project name" VerticalAlignment="Center" />
      <TextBox x:Name="NameBox" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FormTextBox}" Margin="0,3" hc:InfoElement.Placeholder="Folder and file name of the project" />
      <TextBlock Grid.Row="1" Text="Location" VerticalAlignment="Center" />
      <TextBox x:Name="LocationBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FormTextBox}" Margin="0,3" />
      <Button Grid.Row="1" Grid.Column="2" Content="..." Width="32" Margin="6,3,0,3" Click="OnBrowse" ToolTip="Browse" />
      <TextBlock Grid.Row="2" Text="Author" VerticalAlignment="Center" />
      <TextBox x:Name="AuthorBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FormTextBox}" Margin="0,3" hc:InfoElement.Placeholder="Your name or pen name" />
      <TextBlock x:Name="ErrorText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Foreground="{DynamicResource ErrorBrush}" Margin="0,4,0,0" />
    </Grid>

    <!-- Templates -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="260" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="TemplateList" BorderBrush="{DynamicResource BorderBrush}" SelectionChanged="OnTemplateChanged" MouseDoubleClick="OnCreate">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="6,8">
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="26" Foreground="{DynamicResource BrandBrush}" Margin="0,0,14,0" />
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" MaxWidth="360" />
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Column="2">
        <TextBlock x:Name="TemplateTitle" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="TemplateDescription" TextWrapping="Wrap" Foreground="{DynamicResource LabelBrush}" Margin="0,6,0,0" />
        <TextBlock Text="Every project contains a Manuscript folder for chapters and folders for Characters, Places, Items, Factions and Events, just like the folders of a code project."
                   TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,14,0,0" />
      </StackPanel>
    </Grid>
  </DockPanel>
</hc:Window>