<hc:Window x:Class="WritingIDE.Views.AiSettingsDialog" Icon="/Assets/WritingIDE.ico"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="AI Settings" Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
           Background="{DynamicResource ChromeBrush}" NonClientAreaBackground="{DynamicResource ChromeBrush}" FontFamily="Segoe UI" FontSize="12">
  <StackPanel Margin="18,14,18,14">
    <TextBlock Text="AI Settings" FontSize="22" FontWeight="Light" />
    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource LabelBrush}" Margin="0,2,0,10"
               Text="WritingIDE's AI tools (summaries, beta reading, continuity checks, rewrites and Ask About Your Book) work with free AI services. Pick one and paste its free API key; Ollama runs on this PC and needs no key." />

    <TextBlock Style="{StaticResource FormLabel}" Text="Provider" />
    <ComboBox x:Name="ProviderBox" DisplayMemberPath="DisplayName" SelectionChanged="OnProviderChanged" AutomationProperties.Name="AI provider" />
    <Border Background="{DynamicResource InfoPanelBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" Padding="10,6" Margin="0,8,0,0">
      <StackPanel>
        <TextBlock x:Name="NotesText" TextWrapping="Wrap" />
        <Button x:Name="KeyLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnOpenKeyPage" />
      </StackPanel>
    </Border>

    <StackPanel x:Name="KeyPanel">
      <TextBlock Style="{StaticResource FormLabel}" Text="API key" />
      <PasswordBox x:Name="KeyBox" hc:InfoElement.Placeholder="Paste your key" Style="{StaticResource PasswordBoxExtend}" AutomationProperties.Name="API key" />
      <TextBlock Text="Stored encrypted for your Windows account (never in plain text, never in the project)." FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,2,0,0" />
    </StackPanel>

    <TextBlock Style="{StaticResource FormLabel}" Text="Model" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="List models" Margin="8,0,0,0" Click="OnListModels" />
      <ComboBox x:Name="ModelBox" IsEditable="True" AutomationProperties.Name="Model" />
    </DockPanel>

    <TextBlock Style="{StaticResource FormLabel}" Text="Endpoint" />
    <TextBox x:Name="EndpointBox" Style="{StaticResource FormTextBox}" FontFamily="Consolas" AutomationProperties.Name="Endpoint" />

    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="10,6" Margin="0,12,0,0">
      <TextBlock x:Name="ResultText" TextWrapping="Wrap" Text="Test sends a one-line prompt to check the key and model." />
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource DialogButton}" Content="Test" Click="OnTest" AutomationProperties.Name="Test connection" />
      <Button Style="{StaticResource PrimaryDialogButton}" Content="Save" IsDefault="True" Click="OnSave" />
      <Button Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</hc:Window>