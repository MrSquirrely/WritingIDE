<UserControl x:Class="WritingIDE.Views.AiChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource SurfaceBrush}">
  <DockPanel Margin="24,16,24,16" MaxWidth="900">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="Ask About Your Book" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Ask anything: &quot;When did Rowan last see the lighthouse?&quot;, &quot;Which threads are still open?&quot;, &quot;Is Elena's motive clear by chapter 5?&quot;" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ProviderNote}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" />
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
        <Button Style="{StaticResource PrimaryDialogButton}" Content="Ask" Command="{Binding SendCommand}" Margin="0" AutomationProperties.Name="Ask" />
        <Button Style="{StaticResource LinkButton}" Content="Clear" Command="{Binding ClearCommand}" Margin="0,6,0,0" HorizontalAlignment="Center" />
      </StackPanel>
      <CheckBox DockPanel.Dock="Bottom" Content="Send the whole manuscript (best with Gemini; otherwise synopses plus the chapter you are working on)" IsChecked="{Binding IncludeFullText}" Margin="0,6,0,0" />
      <TextBox x:Name="InputBox" Style="{StaticResource FormTextBox}" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="40"
               hc:InfoElement.Placeholder="Ask a question about your book and press Enter" KeyDown="OnInputKeyDown" AutomationProperties.Name="Question" />
    </DockPanel>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border HorizontalAlignment="{Binding Alignment}" MaxWidth="680" CornerRadius="8" Padding="12,8" Margin="0,4">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource CheckedBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                       Foreground="{DynamicResource TextBrush}" FontSize="13" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>