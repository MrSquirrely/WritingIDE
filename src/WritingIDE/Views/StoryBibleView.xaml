<UserControl x:Class="WritingIDE.Views.StoryBibleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource SurfaceBrush}">
  <Grid Margin="28,20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="420" />
      <ColumnDefinition Width="28" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
      <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="6" Background="#68217A" Margin="0,0,14,0">
        <TextBlock Text="&#xE8A4;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock FontSize="24" FontWeight="SemiBold">
          <Run Text="{Binding Project.Name, Mode=OneWay}" /> <Run Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource SubtleTextBrush}" FontWeight="Normal" />
        </TextBlock>
        <TextBlock Text="Premise, tone, themes, world rules and the plot plan: everything about the story as a whole. Characters, places and lore live in their own folders."
                   Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>

    <DockPanel Grid.Row="1">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Style="{StaticResource FormLabel}" Text="Logline" Margin="0,0,0,3" />
        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Project.Synopsis, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                 hc:InfoElement.Placeholder="One or two sentences that sell the story" />
        <TextBlock Style="{StaticResource FormLabel}" Text="Notes" />
      </StackPanel>
      <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Project.Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
               VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Cambria" FontSize="15"
               hc:InfoElement.Placeholder="Premise &amp; tone, themes, the world's rules, the relationship or plot arc, secrets and their rules, hooks for later..." />
    </DockPanel>

    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{StaticResource FormLabel}" Text="Genre" Margin="0,0,0,3" />
        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Project.Genre, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource FormLabel}" Text="Author" />
        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Project.Author, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Visibility="{Binding Project.IsSeries, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource FormLabel}" Text="Books in this series" Margin="0,18,0,6" />
          <ItemsControl ItemsSource="{Binding Project.Books}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8" CornerRadius="4">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE82D;" Foreground="#8E5BB5" Margin="0,0,8,0" />
                      <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" BorderThickness="0" Padding="0" Background="Transparent" />
                    </DockPanel>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Synopsis, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="56" Margin="0,6,0,0" VerticalContentAlignment="Top" hc:InfoElement.Placeholder="What happens in this book" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>